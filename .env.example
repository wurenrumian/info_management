# JWT 签名密钥（生产环境必须修改）
JWT_SECRET=dev-secret-change-in-production

# 微信小程序配置
WECHAT_APP_ID=your_app_id
WECHAT_APP_SECRET=your_app_secret

# 数据库连接（默认连 docker-compose 的 kingbase 服务）
DATABASE_DSN=host=kingbase port=54321 user=system password=123456 dbname=kingbase sslmode=disable

# Kingbase 对宿主机/局域网暴露的端口映射
# 默认等价于 54321:54321；如需限制到单网卡可改为 192.168.1.10:54321:54321
KINGBASE_PORT_BIND=54321:54321

# 服务端口
PORT=8080

# 统一文件上传目录（推荐）
DOCUMENT_UPLOAD_DIR=/data/uploads/documents

# 兼容历史配置（可选，存在时仅用于兼容旧知识库静态路径）
KNOWLEDGE_UPLOAD_DIR=

# 开发模式启用 /api/v1/dev/register-or-login 与 /api/v1/dev/login-and-send-subscribe-check
APP_ENV=dev

# 微信订阅消息开关（开发环境可设为 false 跳过真实调用）
WECHAT_SUBSCRIBE_MSG_ENABLED=true
